# ── Anthropic ─────────────────────────────────────────────
# console.anthropic.com → API keys.  SET A MONTHLY SPEND CAP on this key.
ANTHROPIC_API_KEY=sk-ant-...

# ── Lemon Squeezy ─────────────────────────────────────────
# Numeric variant IDs from each product variant's page. These map a purchase to a tier.
LS_VARIANT_SNAPSHOT=123456
LS_VARIANT_PRO=123457
LS_VARIANT_PASS=123458

# ── Security ──────────────────────────────────────────────
# Comma-separated origins allowed to call the API. Leave unset ONLY in local dev.
ALLOWED_ORIGINS=https://admitmap.com,https://www.admitmap.com

# Local-only test key that bypasses Lemon Squeezy. NEVER set in production.
# DEV_LICENSE=dev-test-key
