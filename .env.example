# ── Anthropic ─────────────────────────────────────────────
# console.anthropic.com → API keys.  SET A MONTHLY SPEND CAP on this key.
ANTHROPIC_API_KEY=sk-ant-...

# ── Polar ─────────────────────────────────────────────────
# polar.sh → Settings → Developers → Organization Access Token.
# Scopes: checkouts:read, checkouts:write, products:read.
# Products are found by their metadata `tier` = chances ($19) / full ($29) — no IDs here.
POLAR_ACCESS_TOKEN=polar_oat_...
# Uncomment to use sandbox.polar.sh (its own token and products):
# POLAR_SERVER=sandbox

# Where Polar sends the buyer back after paying (default https://www.admitmap.app)
# SITE_URL=https://www.admitmap.app

# ── Security ──────────────────────────────────────────────
# Comma-separated origins allowed to call the API. Leave unset ONLY in local dev.
ALLOWED_ORIGINS=https://www.admitmap.app,https://admitmap.app

# Test purchase id that bypasses Polar. NEVER set in production.
# DEV_LICENSE=dev-test-key

# Set to 1 once Polar payments are live: scoring then requires a paid checkout.
# Until then scoring is open to admitmap.app pages, no per-user limit.
# REQUIRE_PURCHASE=1
